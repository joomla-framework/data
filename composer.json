{
    "name": "joomla/data",
    "type": "joomla-package",
    "description": "Joomla Data Package",
    "keywords": ["joomla", "framework", "data"],
    "homepage": "https://github.com/joomla-framework/data",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0",
        "joomla/registry": "dev-4.x-dev"
    },
    "require-dev": {
        "joomla/test": "dev-4.x-dev",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "~3.10.2",
        "phpstan/phpstan": "2.1.17",
        "phpstan/phpstan-deprecation-rules": "2.0.3"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Data\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-2.0-dev": "2.0-dev",
            "dev-3.x-dev": "3.0-dev",
            "dev-4.x-dev": "4.0-dev"
        }
    }
}
